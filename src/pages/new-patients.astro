---
import Layout from '../layouts/Layout.astro';
import BookingButton from '../components/BookingButton.astro';
import { PHONE_DISPLAY, PHONE_TEL } from '../data/site';

const faqs = [
  {
    q: 'Do you take my insurance?',
    a: "We're in network with Delta Dental, Cigna, Aetna, and MetLife. Out-of-network plans are still welcome — we'll file the claim for you and let you know upfront what we expect your plan to cover.",
  },
  {
    q: "What if I don't have insurance?",
    a: 'We offer a in-house membership plan that covers two cleanings, exams, and X-rays a year plus a discount on other treatment, for a flat annual fee. Ask Denise about it when you call.',
  },
  {
    q: 'How long is a new patient visit?',
    a: 'Plan on about an hour. That covers a full exam, X-rays if you need them, a cleaning if time allows, and a chance to actually talk with Dr. Marsh about any concerns.',
  },
  {
    q: 'What should I bring?',
    a: 'A photo ID, your insurance card if you have one, and a list of any medications you take. If you have recent X-rays from a previous dentist, ask them to send copies ahead of time.',
  },
  {
    q: 'I have dental anxiety. Can you work with that?',
    a: "Tell us when you book and we'll flag it on your chart. Dr. Marsh will walk you through each step before she does it, and you can raise a hand any time you need a break.",
  },
];
---
<Layout
  title="New Patients"
  description="What to expect at your first visit to Northgate Family Dental, insurance and payment information, and answers to common questions."
>
  <section class="section pb-10">
    <div class="section-inner reveal" data-reveal>
      <h1 class="text-4xl sm:text-5xl">New patients</h1>
      <p class="mt-4 max-w-prose text-lg text-ink-soft leading-relaxed">
        We've tried to answer the questions people usually ask before their first visit.
        If something's missing, call us at {PHONE_DISPLAY}.
      </p>
      <div class="mt-6">
        <BookingButton event="newPatient" label="Book Your New Patient Exam" />
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="section-inner grid gap-10 lg:grid-cols-2">
      <div class="reveal" data-reveal>
        <h2 class="text-2xl">Your first visit</h2>
        <p class="mt-3 text-ink-soft leading-relaxed">
          A new patient exam runs about an hour. We'll take a set of X-rays if you don't have
          recent ones, check your teeth and gums, and Dr. Marsh will go over anything she finds
          before deciding on next steps together. Most first visits include a cleaning too, if
          there's time in the schedule that day.
        </p>
      </div>
      <div class="reveal" data-reveal style="--reveal-delay: 90ms">
        <h2 class="text-2xl">Insurance & payment</h2>
        <p class="mt-3 text-ink-soft leading-relaxed">
          We're in network with Delta Dental, Cigna, Aetna, and MetLife, and we'll file claims
          for most other plans as a courtesy. We accept cash, card, and CareCredit, and offer
          a simple in-house membership plan for patients without insurance.
        </p>
      </div>
    </div>
  </section>

  <div class="hairline"></div>

  <section class="section" aria-labelledby="faq-heading">
    <div class="section-inner max-w-prose">
      <h2 id="faq-heading" class="reveal text-3xl" data-reveal>Questions people ask</h2>
      <dl class="mt-6 divide-y divide-sand">
        {faqs.map((item, i) => (
          <div
            class="reveal hover-lift py-5 px-3 -mx-3 rounded"
            data-reveal
            style={`--reveal-delay: ${Math.min(i, 4) * 60}ms`}
          >
            <dt class="font-serif text-xl text-pine">{item.q}</dt>
            <dd class="mt-2 text-ink-soft leading-relaxed">{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section bg-pine text-linen">
    <div class="section-inner reveal flex flex-col sm:flex-row sm:items-center justify-between gap-6" data-reveal>
      <div>
        <h2 class="text-3xl text-linen">Ready to come in?</h2>
        <p class="mt-2 text-linen/80">Or call us at <a href={`tel:${PHONE_TEL}`} class="text-linen underline">{PHONE_DISPLAY}</a>.</p>
      </div>
      <BookingButton event="newPatient" label="Book Your New Patient Exam" />
    </div>
  </section>
</Layout>
