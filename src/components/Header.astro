---
import { NAV_LINKS, PHONE_DISPLAY, PHONE_TEL, PRACTICE_NAME } from '../data/site';
import BookingButton from './BookingButton.astro';

const currentPath = Astro.url.pathname;
---
<header id="site-header" class="site-header sticky top-0 z-40 border-b border-sand bg-linen">
  <div class="mx-auto max-w-content px-6 sm:px-10">
    <div class="flex h-20 items-center justify-between">
      <a href="/" class="font-serif text-xl sm:text-2xl font-semibold text-pine no-underline">
        {PRACTICE_NAME}
      </a>

      <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
        {NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`nav-link no-underline font-medium transition-colors duration-200 ${isActive ? 'text-pine' : 'text-ink-soft hover:text-pine'}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <div class="hidden lg:flex items-center gap-5">
        <a href={`tel:${PHONE_TEL}`} class="text-ink-soft no-underline hover:text-pine font-medium transition-colors duration-200">
          {PHONE_DISPLAY}
        </a>
        <BookingButton class="!px-5 !py-2.5 text-sm" />
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 text-pine"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <svg id="icon-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="icon-close" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="lg:hidden border-t border-sand bg-linen">
    <nav class="flex flex-col px-6 py-4 gap-1" aria-label="Mobile">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="no-underline text-ink hover:text-pine py-3 border-b border-sand/60 font-medium transition-colors duration-200">
          {link.label}
        </a>
      ))}
      <a href={`tel:${PHONE_TEL}`} class="no-underline text-ink-soft hover:text-pine py-3 font-medium transition-colors duration-200">
        Call {PHONE_DISPLAY}
      </a>
      <div class="pt-3">
        <BookingButton class="w-full" />
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (header) {
      const updateScrolled = function () {
        header.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      updateScrolled();
      window.addEventListener('scroll', updateScrolled, { passive: true });
    }

    if (!toggle || !menu) return;

    let closeTimer = null;

    function openMenu() {
      clearTimeout(closeTimer);
      menu.hidden = false;
      // Force layout so the browser registers the closed state before we
      // animate to open, even when the element was just un-hidden.
      void menu.offsetHeight;
      menu.classList.add('menu-open');
    }

    function closeMenu() {
      menu.classList.remove('menu-open');
      if (reduceMotion) {
        menu.hidden = true;
      } else {
        closeTimer = setTimeout(function () {
          menu.hidden = true;
        }, 250);
      }
    }

    toggle.addEventListener('click', function () {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      if (expanded) {
        closeMenu();
      } else {
        openMenu();
      }
      iconOpen && iconOpen.classList.toggle('hidden');
      iconClose && iconClose.classList.toggle('hidden');
    });
  })();
</script>
