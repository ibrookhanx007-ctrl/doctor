---
import { ADDRESS, EMAIL, HOURS, NAV_LINKS, PHONE_DISPLAY, PHONE_TEL, PRACTICE_NAME } from '../data/site';
import BookingButton from './BookingButton.astro';

const year = new Date().getFullYear();
---
<footer class="bg-pine text-linen">
  <div class="mx-auto max-w-content px-6 sm:px-10 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-serif text-xl font-semibold">{PRACTICE_NAME}</p>
      <p class="mt-3 text-linen/80 leading-relaxed">
        {ADDRESS.line1}<br />
        {ADDRESS.line2}
      </p>
      <a href={`tel:${PHONE_TEL}`} class="block mt-3 text-linen no-underline hover:underline">{PHONE_DISPLAY}</a>
      <a href={`mailto:${EMAIL}`} class="block mt-1 text-linen no-underline hover:underline">{EMAIL}</a>
    </div>

    <div>
      <p class="font-serif text-lg font-semibold">Hours</p>
      <ul class="mt-3 space-y-2">
        {HOURS.filter((h) => h.hours !== 'Closed').map((row) => (
          <li class="flex justify-between gap-4 text-linen/80">
            <span>{row.label}</span>
            <span class="whitespace-nowrap">{row.hours}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-serif text-lg font-semibold">Explore</p>
      <ul class="mt-3 space-y-2">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class="text-linen/80 no-underline hover:text-linen hover:underline">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col items-start gap-3">
      <p class="font-serif text-lg font-semibold">Ready when you are</p>
      <BookingButton />
    </div>
  </div>

  <div class="border-t border-linen/15">
    <div class="mx-auto max-w-content px-6 sm:px-10 py-5 text-sm text-linen/60">
      © {year} {PRACTICE_NAME}. All rights reserved.
    </div>
  </div>
</footer>
