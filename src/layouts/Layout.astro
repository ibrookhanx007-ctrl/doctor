---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CalScript from '../components/CalScript.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { PRACTICE_NAME } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {PRACTICE_NAME}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#1E3D34" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${PRACTICE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Dentist',
      name: PRACTICE_NAME,
      image: 'https://northgatefamilydental.example/og-image.jpg',
      telephone: '+1-828-555-0148',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '214 Northgate Avenue',
        addressLocality: 'Asheville',
        addressRegion: 'NC',
        postalCode: '28804',
        addressCountry: 'US',
      },
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '08:00', closes: '17:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday'], opens: '08:00', closes: '13:00' },
      ],
    })} />

    <CalScript />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ScrollReveal />
  </body>
</html>
