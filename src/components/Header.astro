---
import { NAV_LINKS, PHONE_DISPLAY, PHONE_TEL, PRACTICE_NAME } from '../data/site';
import BookingButton from './BookingButton.astro';

const currentPath = Astro.url.pathname;
---
<header class="border-b border-sand bg-linen">
  <div class="mx-auto max-w-content px-6 sm:px-10">
    <div class="flex h-20 items-center justify-between">
      <a href="/" class="font-serif text-xl sm:text-2xl font-semibold text-pine no-underline">
        {PRACTICE_NAME}
      </a>

      <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
        {NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`no-underline font-medium ${isActive ? 'text-pine' : 'text-ink-soft hover:text-pine'}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <div class="hidden lg:flex items-center gap-5">
        <a href={`tel:${PHONE_TEL}`} class="text-ink-soft no-underline hover:text-pine font-medium">
          {PHONE_DISPLAY}
        </a>
        <BookingButton class="!px-5 !py-2.5 text-sm" />
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 text-pine"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <svg id="icon-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="icon-close" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-sand bg-linen">
    <nav class="flex flex-col px-6 py-4 gap-1" aria-label="Mobile">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="no-underline text-ink py-3 border-b border-sand/60 font-medium">
          {link.label}
        </a>
      ))}
      <a href={`tel:${PHONE_TEL}`} class="no-underline text-ink-soft py-3 font-medium">
        Call {PHONE_DISPLAY}
      </a>
      <div class="pt-3">
        <BookingButton class="w-full" />
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!toggle || !menu) return;
    toggle.addEventListener('click', function () {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      iconOpen && iconOpen.classList.toggle('hidden');
      iconClose && iconClose.classList.toggle('hidden');
    });
  })();
</script>
