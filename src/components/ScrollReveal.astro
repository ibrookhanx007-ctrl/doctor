---
// Powers every [data-reveal] element: fades/slides an element in the first
// time it enters the viewport, then leaves it alone (no re-triggering on
// scroll back up/down). Degrades safely — reduced motion, no JS, and no
// IntersectionObserver support all just show content immediately.
---
<noscript>
  <style>
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<script is:inline>
  (function () {
    var els = document.querySelectorAll('[data-reveal]');
    if (!els.length) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion || !('IntersectionObserver' in window)) {
      els.forEach(function (el) {
        el.classList.add('reveal', 'is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    els.forEach(function (el) {
      el.classList.add('reveal');
      observer.observe(el);
    });
  })();
</script>
